#!/usr/bin/env python3
"""web-clipper: the command this plugin puts on PATH; runs the skill's clip.py with the same arguments.

Claude Code adds the plugin's bin/ to the Bash tool's PATH while the plugin is enabled. The
script finds clip.py through its own resolved path, so it also works through a symlink.
"""
import os
import sys
from pathlib import Path

CLIP = Path(__file__).resolve().parents[1] / "skills" / "web-clipper" / "scripts" / "clip.py"
os.execv(sys.executable, [sys.executable, str(CLIP), *sys.argv[1:]])
