{
	"schemaVersion": "0.1.0",
	"name": "row",
	"behavior": "create",
	"noteContentFormat": "{{content}}",
	"properties": [
		{ "name": "source", "value": "{{url}}", "type": "text" },
		{ "name": "title", "value": "{{title}}", "type": "text" },
		{ "name": "author", "value": "{{author|split:\", \"|wikilink|join}}", "type": "text" },
		{ "name": "published", "value": "{{published}}", "type": "date" },
		{ "name": "created", "value": "{{date}}", "type": "date" },
		{ "name": "description", "value": "{{description}}", "type": "text" },
		{ "name": "tags", "value": "row", "type": "multitext" }
	],
	"triggers": [],
	"noteNameFormat": "{{title}}",
	"path": "raw"
}
